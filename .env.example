# =============================================================================
# NISKAVA AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single Source of Truth (SSoT) for Local Development & Deployment
#
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
#
# CATATAN KEAMANAN (HUKUM 7 / AGENTS.md):
#   File .env asli diabaikan oleh git (.gitignore) dan JANGAN PERNAH di-commit.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECTORS FINANCIAL API v2 (Wajib untuk Data Saham IDX Live)
# -----------------------------------------------------------------------------
# Dapatkan API Key di: https://sectors.app atau portal Sectors Hackathon 2026.
# Kuota: 1.000 kredit grant.
SECTORS_API_KEY=

# Base URL Sectors API v2 (Default resmi)
SECTORS_BASE_URL=https://api.sectors.app/v2

# MODE HEMAT KREDIT (HUKUM 5):
# Set ke 1 untuk menggunakan data mock/cache lokal selama testing tanpa memotong kredit API.
# Set ke 0 untuk koneksi live data ke bursa IDX.
MOCK_SECTORS=0
NISKAVA_OFFLINE=0

# -----------------------------------------------------------------------------
# 2. AI / LLM REASONING MODEL (ReAct Cognitive Agent)
# -----------------------------------------------------------------------------
# Model Utama yang Direkomendasikan: Google Gemini 2.0 Flash
# Dapatkan gratis API key di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Model Alternatif (Opsional jika ingin menggunakan provider lain):
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama / Local LLM (100% Offline di mesin lokal)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# -----------------------------------------------------------------------------
# 3. LOCAL-FIRST PERSISTENCE & STORAGE (HUKUM 4)
# -----------------------------------------------------------------------------
# Lokasi database SQLite lokal dengan Write-Ahead Logging (WAL Mode)
NISKAVA_DB_PATH=~/.niskava/niskava.db

# -----------------------------------------------------------------------------
# 4. RUNTIME ENGINE & LOCAL IPC
# -----------------------------------------------------------------------------
# Path ke interpreter Python (gunakan virtual environment .venv lokal)
NISKAVA_PYTHON_BIN=.venv/bin/python3

# Direktori entrypoint Python engine
NISKAVA_ENGINE_PATH=./engine

# Pasar bursa default (Bursa Efek Indonesia)
NISKAVA_DEFAULT_MARKET=IDX

# -----------------------------------------------------------------------------
# 5. LOCAL DAEMON SERVER & WEB WORKSPACE
# -----------------------------------------------------------------------------
# Port lokal untuk REST API & SSE Streaming Web Workspace
NISKAVA_PORT=8080

# -----------------------------------------------------------------------------
# 6. TARGETED OSINT HARVESTER (NEWS & FILINGS)
# -----------------------------------------------------------------------------
# Batas jumlah artikel berita yang diambil per jendela anomali (T ± 2 hari)
NEWS_HARVEST_MAX_ARTICLES=5

# Batas waktu timeout HTTP request untuk scraping (detik)
NEWS_TIMEOUT_SECONDS=10
