# =============================================================================
# NISKAVA AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single Source of Truth (SSoT) for Local Development & Deployment
#
# Petunjuk Penggunaan:
#   1. Salin template ini menjadi file .env:
#        cp .env.example .env
#   2. Atau jalankan wizard konfigurasi interaktif:
#        ./bin/niskava setup
#
# CATATAN KEAMANAN (Law 7 / AGENTS.md):
#   File .env asli diabaikan oleh git (.gitignore) dan JANGAN PERNAH di-commit.
#   Hak akses file .env yang aman adalah 0600 (chmod 600 .env).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECTORS FINANCIAL API v2 (Data Pasar Saham IDX)
# -----------------------------------------------------------------------------
# Dapatkan API Key di: https://sectors.app (Hibah 1.000 kredit grant Hackathon 2026).
# Kosongkan atau gunakan MOCK_SECTORS=1 untuk mode offline/testing gratis.
SECTORS_API_KEY=

# Base URL resmi Sectors Financial API v2
SECTORS_BASE_URL=https://api.sectors.app/v2

# MODE DISIPLIN KREDIT (Law 5):
# Set 1: Menggunakan fixture data mock dan cache lokal SQLite (~/.niskava/niskava.db).
#        Kredit API Sectors aman 0 terpakai. Wajib digunakan untuk CI/CD dan unit test.
# Set 0: Mengambil data real-time live dari server Sectors IDX.
MOCK_SECTORS=0
NISKAVA_OFFLINE=0

# -----------------------------------------------------------------------------
# 2. AI INFERENCE & REASONING MODEL (ReAct Cognitive Engine)
# -----------------------------------------------------------------------------
# Provider aktif: "openai" atau "gemini"
# Catatan: "openai" mencakup OpenRouter, 9router, Groq, DeepSeek, Ollama, dan proxy OpenAI-compatible.
AI_PROVIDER=openai

# --- Pilihan A: External Router / Gateway (Rekomendasi untuk Fleksibilitas) ---
# Contoh OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-your-key-here
#   OPENAI_MODEL=deepseek/deepseek-chat
#
# Contoh 9router / LiteLLM Lokal (Port 20128):
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=sk-your-router-key
OPENAI_MODEL=hermes

# --- Pilihan B: Google Gemini Cloud (Google AI Studio) ---
# Dapatkan API Key di: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Pilihan C: Anthropic Claude (Opsional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Pilihan D: Ollama / Model Privat Lokal (100% Offline) ---
# Jalankan 'ollama run llama3.2' atau 'ollama run deepseek-r1:8b'
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# 3. INFERENCE TIMEOUT & ADAPTIVE SCALING (Detik)
# -----------------------------------------------------------------------------
# Batas waktu tunggu dasar untuk setiap langkah penalaran model AI (range: 10 - 300).
# Niskava menerapkan rumus Adaptive Timeout otomatis:
#   Timeout Aktual = Base Timeout + (Jumlah Observasi Tool x 10 detik)
#
# Profil Rekomendasi:
#   25.0  : Fast / Cloud API dengan latensi rendah (OpenAI GPT-4o-mini, Groq)
#   60.0  : Balanced / Default [Direkomendasikan] (Cukup untuk multi-tool IDX)
#   120.0 : Deep Reasoning Cloud (o3, Gemini 2.5 Pro, DeepSeek R1)
#   180.0 : Local LLM / CPU Inference (Ollama tanpa GPU dedicated)
NISKAVA_LLM_TIMEOUT=60.00

# -----------------------------------------------------------------------------
# 4. PENYIMPANAN DATA LOKAL-FIRST (Law 4: Local-First Data Sovereignty)
# -----------------------------------------------------------------------------
# Lokasi database SQLite tunggal dengan Write-Ahead Logging (PRAGMA journal_mode = WAL).
# Menyimpan riwayat obrolan, graf memori asosiatif, cache Sectors, dan audit trail.
NISKAVA_DB_PATH=~/.niskava/niskava.db

# -----------------------------------------------------------------------------
# 5. RUNTIME PYTHON ENGINE & LINGKUNGAN VIRTUAL
# -----------------------------------------------------------------------------
# Path ke executable Python dengan dependensi NumPy/Pandas (Law 1: Deterministic Math).
# Disarankan menggunakan virtual environment lokal (.venv).
NISKAVA_PYTHON_BIN=.venv/bin/python3

# Lokasi folder kode Python engine (relatif dari root repo)
NISKAVA_ENGINE_PATH=./backend/engine

# Pasar bursa acuan default (IDX = Bursa Efek Indonesia)
NISKAVA_DEFAULT_MARKET=IDX

# Batas iterasi maksimum ReAct agent loop
NISKAVA_MAX_REACT_ITERATIONS=30

# -----------------------------------------------------------------------------
# 6. SERVER DAEMON REST/SSE & WEB WORKSPACE
# -----------------------------------------------------------------------------
# Port lokal untuk REST API dan antarmuka web visual (http://localhost:8080)
NISKAVA_PORT=8080

# -----------------------------------------------------------------------------
# 7. SECTORS NEWS ENGINE & CORPORATE DISCLOSURES
# -----------------------------------------------------------------------------
# Jumlah maksimum artikel berita & keterbukaan informasi per jendela anomali (T ± 2 hari)
NEWS_HARVEST_MAX_ARTICLES=5

# Batas waktu timeout pengambilan berita (detik)
NEWS_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# 8. INTEGRASI TELEGRAM BOT (Opsional)
# -----------------------------------------------------------------------------
# Jalankan 'niskava telegram' untuk mengaktifkan bot asisten pasar di ponsel.
NISKAVA_TELEGRAM_TOKEN=
NISKAVA_TELEGRAM_ENABLED=0

# Daftar User ID Telegram yang memiliki izin akses (pisahkan dengan koma)
NISKAVA_TELEGRAM_ALLOWED_USERS=

# -----------------------------------------------------------------------------
# 9. PREFERENSI BAHASA ANTARMUKA
# -----------------------------------------------------------------------------
# Pilihan: "en" (Bahasa Inggris) atau "id" (Bahasa Indonesia)
NISKAVA_LANG=en
