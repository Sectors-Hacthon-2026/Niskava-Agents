# =============================================================================
# NISKAVA AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single Source of Truth (SSoT) for Local Development & Deployment
#
# Quickstart:
#   1. Copy this template to create your local .env file:
#        cp .env.example .env
#   2. Or run the interactive setup wizard:
#        ./bin/niskava setup
#
# SECURITY NOTICE (Law 7 / AGENTS.md):
#   The actual .env file is git-ignored (.gitignore) and MUST NEVER BE COMMITTED.
#   Recommended file permissions: 0600 (chmod 600 .env).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SECTORS FINANCIAL API v2 (IDX Market Data)
# -----------------------------------------------------------------------------
# Get your API key at: https://sectors.app (1,000 credit grant for Hackathon 2026).
# Leave empty or set MOCK_SECTORS=1 for offline testing without credit consumption.
SECTORS_API_KEY=

# Official base URL for Sectors Financial API v2
SECTORS_BASE_URL=https://api.sectors.app/v2

# CREDIT CONSERVATION MODE (Law 5):
# 1 = Use local mock fixtures and local SQLite cache (~/.niskava/niskava.db).
#     Incurs 0 Sectors API credit usage. Mandatory for CI/CD and unit tests.
# 0 = Fetch live real-time market data from Sectors API server.
MOCK_SECTORS=0
NISKAVA_OFFLINE=0

# -----------------------------------------------------------------------------
# 2. AI INFERENCE & REASONING MODEL (ReAct Cognitive Engine)
# -----------------------------------------------------------------------------
# Active provider: "openai" or "gemini"
# Note: "openai" supports OpenAI, OpenRouter, 9router, Groq, DeepSeek, Ollama,
# and any OpenAI-compatible proxy gateway.
AI_PROVIDER=openai

# --- Option A: External Router / Gateway (Recommended for Flexibility) ---
# Example for OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-your-key-here
#   OPENAI_MODEL=deepseek/deepseek-chat
#
# Example for Local 9router / LiteLLM Proxy (Port 20128):
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=sk-your-router-key
OPENAI_MODEL=gpt-4o-mini

# --- Option B: Google Gemini Cloud (Google AI Studio) ---
# Obtain API key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Option C: Anthropic Claude (Optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Option D: Ollama / Local Private LLM (100% Offline) ---
# Run 'ollama run llama3.2' or 'ollama run deepseek-r1:8b'
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# 3. INFERENCE TIMEOUT & ADAPTIVE SCALING (Seconds)
# -----------------------------------------------------------------------------
# Base timeout for each model reasoning iteration (clamped between 10.0 and 300.0s).
# Niskava applies automatic Adaptive Timeout scaling:
#   Actual Timeout = Base Timeout + (Tool Observation Count x 10s)
#
# Recommended Profiles:
#   25.0  : Fast / Low-latency Cloud APIs (OpenAI GPT-4o-mini, Groq)
#   60.0  : Balanced / Default [Recommended] (Sufficient for multi-tool IDX queries)
#   120.0 : Deep Reasoning Models (o3-mini, Gemini 2.5 Pro, DeepSeek R1)
#   180.0 : Local CPU / Edge Inference (Ollama without dedicated GPU acceleration)
NISKAVA_LLM_TIMEOUT=60.00

# -----------------------------------------------------------------------------
# 4. LOCAL-FIRST DATA STORAGE (Law 4: Local-First Sovereignty)
# -----------------------------------------------------------------------------
# Path to local SQLite database with Write-Ahead Logging (PRAGMA journal_mode = WAL).
# Stores chat sessions, memory ego-graph, Sectors HTTP cache, and audit findings.
NISKAVA_DB_PATH=~/.niskava/niskava.db

# -----------------------------------------------------------------------------
# 5. PYTHON RUNTIME & ENGINE PATH
# -----------------------------------------------------------------------------
# Path to Python executable with NumPy/Pandas installed (Law 1: Deterministic Math).
# Using a local virtual environment (.venv) is highly recommended.
NISKAVA_PYTHON_BIN=.venv/bin/python3

# Relative or absolute directory containing the Python engine
NISKAVA_ENGINE_PATH=./backend/engine

# Default equity market identifier (IDX = Indonesia Stock Exchange)
NISKAVA_DEFAULT_MARKET=IDX

# Maximum depth for autonomous ReAct agent reasoning iterations
NISKAVA_MAX_REACT_ITERATIONS=30

# -----------------------------------------------------------------------------
# 6. REST/SSE SERVER DAEMON & WEB WORKSPACE
# -----------------------------------------------------------------------------
# Port for local REST API and visual Web Workspace terminal (http://localhost:20128 or 8080)
NISKAVA_PORT=20128

# -----------------------------------------------------------------------------
# 7. SECTORS NEWS ENGINE & CORPORATE DISCLOSURES
# -----------------------------------------------------------------------------
# Maximum news articles and corporate filings gathered per anomaly window (T ± 2 days)
NEWS_HARVEST_MAX_ARTICLES=5

# HTTP request timeout for news fetching (seconds)
NEWS_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# 8. TELEGRAM BOT INTEGRATION (Optional)
# -----------------------------------------------------------------------------
# Run 'niskava telegram' or enable the daemon to interact via Telegram.
# Telegram Bot Token from @BotFather (also accepts TELEGRAM_BOT_TOKEN)
NISKAVA_TELEGRAM_TOKEN=
NISKAVA_TELEGRAM_ENABLED=0

# Comma-separated list of authorized Telegram User IDs or @usernames
# Leave blank to allow any user (if running in private terminal mode)
NISKAVA_TELEGRAM_ALLOWED_USERS=

# -----------------------------------------------------------------------------
# 9. USER INTERFACE & PERSONA LANGUAGE
# -----------------------------------------------------------------------------
# Options: "en" (English) or "id" (Bahasa Indonesia)
NISKAVA_LANG=en

