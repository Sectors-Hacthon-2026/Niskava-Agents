# ==========================================
# Niskava Agent - NPM Distribution Exclusions
# ==========================================

# --- Secrets, Environment & Credentials (CRITICAL - Law 7) ---
.env
.env.*
*.env
*.key
*.pem
config.yaml
config.local.yaml

# --- Local Databases & SQLite (Law 4) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.journal

# --- Python Virtualenv & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
env/
venv/
backend/engine/tests/
backend/engine/evals/

# --- Git & CI/CD Internal ---
.git/
.github/
.gitignore
.npmignore
Makefile
Dockerfile
docker-compose.yml
install.sh
install.ps1
run.sh
run.bat

# --- Documentation & Internal Plans ---
docs/
graphify-out/
.graphify_*

# --- Go Source (Pre-built binary is distributed in bin/ or built on host) ---
cmd/
clients/cli/
clients/web/
internal/
vendor/
go.mod
go.sum
